# Required administrator credentials. Replace every placeholder before starting.
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-a-long-random-password
# Must contain at least 32 characters and must differ from ADMIN_PASSWORD.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Runtime mode. Production enables Secure session cookies by default.
NODE_ENV=production

# Public website URL used when generating counter links.
# APP_SITE=https://counter.example.com

# Application port.
APP_PORT=3000

# Database type: either 'sqlite' or 'mongodb'.
DB_TYPE=sqlite

# MongoDB connection string. Include an explicit database name.
# In Docker Compose, use the MongoDB service name instead of 127.0.0.1.
# DB_URL=mongodb://mongo:27017/moe-counter

# Database write interval in seconds (0 for real-time).
DB_INTERVAL=60

# Persistent administrator session database.
SESSION_DB_PATH=data/admin-sessions.db

# Override Secure cookies only for deliberate plain-HTTP development.
# SESSION_COOKIE_SECURE=false

# Trusted reverse proxy hops or comma-separated addresses/CIDRs.
# Keep false when the application is directly exposed.
TRUST_PROXY=false

# Log level: 'debug', 'info', 'warn', 'error', or 'none'.
LOG_LEVEL=debug

# Google Analytics G-Tag ID.
# GA_ID=G-XXXX
